{
  "name": "stream-subtitles",
  "version": "2.0.0",
  "description": "Chrome Extension for real-time subtitle generation, transcription, and bilingual translation using Web Speech API, Deepgram, and Claude AI",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:bdd": "cucumber-js",
    "test:all": "npm run test && npm run test:bdd"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@cucumber/cucumber": "^10.0.0",
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer": "^21.5.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "extension/**/*.js",
      "!extension/**/node_modules/**",
      "!extension/**/*.test.js",
      "!extension/**/*.spec.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ]
  }
}
